import hashlib
import json
import os
import signal
import sqlite3
import subprocess
import sys
import threading
import uuid
from collections.abc import Iterator
from pathlib import Path
from typing import Any

TEST_MODE = os.environ.get("CRG_TEST_MODE") == "1"


def test_override(name: str, default: str) -> str:
    return os.environ.get(name, default) if TEST_MODE else default


USER_ROOT = Path(test_override("CRG_USER_ROOT", str(Path.home()))).expanduser().resolve()
CONTROL_ROOT = Path(
    test_override("CRG_CONTROL_ROOT", str(USER_ROOT / ".code-review-graph"))
).expanduser().resolve()
CONTROL_DB_PATH = CONTROL_ROOT / "control.db"
CONTROL_INIT_LOCK_PATH = Path(
    test_override("CRG_CONTROL_INIT_LOCK", str(CONTROL_ROOT / "control-init.lock"))
)
COORDINATOR_LOCK_PATH = Path(
    test_override(
        "CRG_COORDINATOR_LOCK", str(CONTROL_ROOT / "lifecycle-coordinator.lock")
    )
)
WORKTREE_LOCK_DIR = Path(
    test_override("CRG_WORKTREE_LOCK_DIR", str(CONTROL_ROOT / "locks"))
)
SAFE_REFRESH = Path(
    test_override("CRG_SAFE_REFRESH", str(USER_ROOT / ".local/bin/crg-safe-refresh"))
)
CRG_BIN = Path(
    test_override("CRG_BIN", str(USER_ROOT / ".local/bin/code-review-graph"))
)
CRG_PYTHON = Path(
    test_override(
        "CRG_PYTHON",
        str(USER_ROOT / ".local/share/uv/tools/code-review-graph/bin/python"),
    )
)
LAUNCH_LABEL = test_override(
    "CRG_LAUNCH_LABEL", "com.code-review-graph.safe-refresh"
)

MAX_CHANGED_FILES = int(os.environ.get("CRG_MAX_CHANGED_FILES", "500"))
MAX_CHANGED_RATIO = float(os.environ.get("CRG_MAX_CHANGED_RATIO", "0.15"))
MAX_FRAGMENTATION_RATIO = float(os.environ.get("CRG_MAX_FRAGMENTATION_RATIO", "0.20"))
DB_LIMIT_BYTES = int(os.environ.get("CRG_DB_LIMIT_BYTES", str(1536 * 1024 * 1024)))
TOTAL_GRAPH_LIMIT_BYTES = int(
    os.environ.get("CRG_TOTAL_GRAPH_LIMIT_BYTES", str(10 * 1024 * 1024 * 1024))
)
COMMAND_TIMEOUT_SECONDS = int(os.environ.get("CRG_COMMAND_TIMEOUT_SECONDS", "1800"))
MAX_ITEMS_PER_RUN = max(1, int(os.environ.get("CRG_MAX_ITEMS_PER_RUN", "4")))
GRAPH_PROVISION_REASONS = {"agent:graph-needed", "manual:build"}
STALE_SWEEP_REASON = "lifecycle:stale-graph"
